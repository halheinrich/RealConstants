<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework, LangVersion, Nullable, ImplicitUsings, analyzer settings
    and XML doc generation all come from Directory.Build.props.

    This is a runnable project, not a test project, and the distinction is
    ruled rather than stylistic. ../AGENTS.md § Exactness discipline: a target
    with a known answer belongs in a test project and gates CI; a long run that
    prints a table has no pass or fail and must not masquerade as a test. What
    lives here depends on wall-clock time, which a test may not.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HalHeinrich.Numerics.Experiments</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      Same reasoning as the test project's. GenerateDocumentationFile is
      inherited as true because it is IDE0005's documented prerequisite, and
      CS1591 is suppressed because experiment methods are named rather than
      documented - halheinrich/Math#43.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RealConstants\RealConstants.csproj" />
  </ItemGroup>

  <!--
    The selector grammar is ordinary deterministic code and is unit-tested, so
    the test project needs to see it. Everything here is internal, matching
    RationalApproximation's arrangement for the same reason: the types are an
    implementation of this runner, not a surface anything else may build on.

    Testing a string parser does not make this a test project. AGENTS.md
    section Exactness discipline separates them by whether a run has a known
    answer and whether it depends on wall-clock time; the parser has one and
    does not.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="RealConstants.Tests" />
  </ItemGroup>

</Project>
